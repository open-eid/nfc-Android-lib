<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. The demo app writes signed ASiC-E
  containers under the app's files dir at "containers/"; those can carry
  signer certificates and document content, so exclude them from both
  cloud backup and device-to-device transfer. See:
  https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="containers/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="containers/"/>
    </device-transfer>
</data-extraction-rules>
